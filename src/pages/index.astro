---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { PILLARS } from '../site';

const posts = (await getCollection('posts', ({ data }) => !data.draft && !data.archived))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' });
const featured = ['securing-ai', 'ai-for-defenders', 'security-leadership'];
---
<Base>
  <p class="eyebrow">AI &amp; cloud security</p>
  <h1>Securing software that makes its own decisions.</h1>
  <p class="lede">
    I'm a security engineer working where AI and cloud security meet. I write about what changes
    when systems start acting on their own, and how to explain that risk to the people who fund the fix.
  </p>
  <ul class="proof">
    <li>4 yrs cloud security engineering</li>
    <li>Berkeley Haas MBA '27</li>
    <li>WiCyS 2027 program reviewer</li>
  </ul>
  <a class="cta" href="/writing/">Read the writing</a>

  <h2>What I write about</h2>
  <div class="pillars">
    {featured.map((k) => (
      <div class="pillar">
        <h3>{PILLARS[k].label}</h3>
        <p>{PILLARS[k].blurb}</p>
      </div>
    ))}
  </div>

  <h2>Latest</h2>
  {posts.length === 0 ? (
    <p class="muted">First posts are on the way.</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <span class="meta">{fmt(p.data.date)} · {PILLARS[p.data.pillar].label}</span><br />
          <a href={`/writing/${p.id}/`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  )}

  <h2>Now</h2>
  <div class="now">
    <!-- Update monthly. Keep it to 3 lines. -->
    <ul>
      <li>Reviewing talk submissions for WiCyS 2027.</li>
      <li>Thinking about permission models for AI agents with tool access.</li>
      <li>Finishing my MBA at Berkeley Haas.</li>
    </ul>
    <p class="now-date">Updated October 2026</p>
  </div>
</Base>
