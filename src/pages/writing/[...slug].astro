---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { PILLARS } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <div class="meta">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time>
      {post.data.updated && <span>Updated {fmt(post.data.updated)}</span>}
      {post.data.pillar !== 'general' && <span class="topic">{PILLARS[post.data.pillar].label}</span>}
    </div>
    <h1>{post.data.title}</h1>
    {post.data.archived && (
      <div class="archive-note">
        <p>{post.data.archiveNote ?? 'From the archive. I wrote this earlier in my career and have kept it largely as published.'}</p>
      </div>
    )}
    <Content />
    <hr />
    <p><a class="back" href="/writing/">Back to all writing</a></p>
  </article>
</Base>
