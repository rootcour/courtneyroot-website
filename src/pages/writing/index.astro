---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getLivePosts } from '../../lib/posts';

const posts = await getLivePosts();
const current = posts.filter((p) => !p.data.archived);
const archive = posts.filter((p) => p.data.archived);
---
<Base title="Writing" description="Essays on securing AI systems, AI for defenders, and security leadership.">
  <div class="page-intro">
    <h1>Writing</h1>
    <p class="lede">Practical writing on securing AI systems, what recent breaches teach us, and how business and security teams can make better decisions together.</p>
    <p>Follow along with <a href="/rss.xml">RSS</a>.</p>
  </div>

  {current.length > 0 ? (
    <PostList posts={current} />
  ) : (
    <div class="empty-state prose">
      <p>New essays on AI security start here soon. The first one is a threat model for AI agents with tool access.</p>
    </div>
  )}

  {archive.length > 0 && (
    <>
      <div class="section-head">
        <h2>Archive</h2>
      </div>
      <p class="prose">Case studies and essays from my Georgia Tech cybersecurity master's, lightly edited.</p>
      <PostList posts={archive} />
    </>
  )}
</Base>
