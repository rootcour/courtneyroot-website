---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

// Add entries as you give talks: { event, title, date, link? }
const talks: { event: string; title: string; date: string; link?: string }[] = [];
---
<Base title="Speaking" description="Talks and panels on AI security, cloud security, and security leadership.">
  <div class="page-intro">
    <h1>Speaking</h1>
    <p class="lede">I speak with engineering, security and leadership audiences about what AI changes in security.</p>
  </div>

  <div class="section-head"><h2>Talks I can give</h2></div>
  <ul class="topics">
    <li>
      <h3>Threat modeling AI agents</h3>
      <p>What changes when software has tools, memory and permissions, and the controls that actually matter.</p>
    </li>
    <li>
      <h3>AI in the SOC, honestly</h3>
      <p>Where AI helps defenders today, where it adds risk, and how to tell the difference.</p>
    </li>
    <li>
      <h3>Security for the boardroom</h3>
      <p>Turning technical risk into decisions executives and boards can act on.</p>
    </li>
    <li>
      <h3>Getting your first CFP accepted</h3>
      <p>Lessons from the reviewer's side of the table, for first-time speakers.</p>
    </li>
  </ul>

  <div class="section-head"><h2>Past and upcoming</h2></div>
  {talks.length === 0 ? (
    <div class="empty-state prose">
      <p>My first talks will be listed here. Want to be the first? Use the contact details below.</p>
    </div>
  ) : (
    <ul class="posts">
      {talks.map((t) => (
        <li>
          <time>{t.date}</time>
          <div><h3>{t.link ? <a href={t.link}>{t.title}</a> : t.title}</h3><p>{t.event}</p></div>
        </li>
      ))}
    </ul>
  )}

  <div class="section-head"><h2>Invite me</h2></div>
  <p class="prose">
    For conferences, podcasts, panels or guest lectures, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    Bios and a headshot are on the <a href="/about/#bios">About page</a>.
  </p>
</Base>
