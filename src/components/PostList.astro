---
import type { CollectionEntry } from 'astro:content';
import { PILLARS } from '../site';

interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' });
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
      <div>
        <h3><a href={`/writing/${p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.description}</p>
        {p.data.pillar !== 'general' && <p class="topic">{PILLARS[p.data.pillar].label}</p>}
      </div>
    </li>
  ))}
</ul>
